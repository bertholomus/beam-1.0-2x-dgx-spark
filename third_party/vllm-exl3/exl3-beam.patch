+    tmp = torch.empty((K * f8["max_slice"],), dtype=torch.float16, device=device)
+    for l, off, n in f8["shards"]:
+        for n0 in range(0, n, _EXL3_FP8_SLICE):
+            n1 = min(n, n0 + _EXL3_FP8_SLICE)
+            w16 = tmp[: K * (n1 - n0)].view(K, n1 - n0)
+            ext.reconstruct_had_slice(w16, l.trellis, l.suh, l.svh[n0:], l.K, l.mcg, l.mul1, n0)
+            _f8_convert(w16, inv[off + n0: off + n1], w8[off + n0: off + n1])
+    return w8
+
