+        sc = _XDENSE_STATE[("sc", dev)] = (torch.empty(_XD_TEMP_ELEMS, dtype=torch.float16, device=dev),
+                                           torch.empty(_XD_CTMP_ELEMS, dtype=torch.float16, device=dev),
+                                           [torch.full((64,), m, dtype=torch.int32, device=dev) for m in range(17)])
+    return sc
+
+
+def _xdense_desc(linears):
+    try:
+        if not linears or any(l is None for l in linears):
+            return None
+        Ks = {int(l.K) for l in linears}; ins = {int(l.in_features) for l in linears}
+        if Ks != {6} or len(ins) != 1 or not all(bool(l.mcg) and not bool(l.mul1) for l in linears):
+            return None
+        in_f = ins.pop(); widths = [int(l.out_features) for l in linears]
+        W = 512 if all(w % 512 == 0 for w in widths) else (256 if all(w % 256 == 0 for w in widths) else 0)
+        if not W or in_f % 128 or len(linears) * 16 * in_f > _XD_TEMP_ELEMS:
+            return None
+        J = sum(w // W for w in widths)
+        if J > 64 or J * 16 * W > _XD_CTMP_ELEMS:
+            return None
+        dev = linears[0].trellis.device
+        temp, ctmp, rows_tab = _xdense_scratch(dev)
+        ap, bp, cp, bnf, sv, off = [], [], [], [], [], []
+        col = 0; j = 0
+        for i, (l, w) in enumerate(zip(linears, widths)):
+            tr = l.trellis
+            if tr.dim() != 3 or tr.shape[-1] != 16 * 6 or tr.dtype != torch.int16 or not tr.is_contiguous() or not l.svh.is_contiguous():
+                return None
+            for n0 in range(0, w, W):
+                ap.append(temp.data_ptr() + i * 16 * in_f * 2)
+                bp.append(tr.data_ptr() + (n0 // 16) * 16 * 6 * tr.element_size())
+                cp.append(ctmp.data_ptr() + j * 16 * W * 2)
+                bnf.append(w // 16); sv.append(l.svh.data_ptr() + n0 * l.svh.element_size()); off.append(col + n0); j += 1
+            col += w
+        L = lambda v, d: torch.tensor(v, dtype=d, device=dev)
+        return {"in_f": in_f, "W": W, "total": col, "temp": temp, "rows": rows_tab,
+                "suh": L([l.suh.data_ptr() for l in linears], torch.long), "a": L(ap, torch.long), "b": L(bp, torch.long),
+                "c": L(cp, torch.long), "bnf": L(bnf, torch.int32), "svh": L(sv, torch.long), "off": L(off, torch.long)}
+    except Exception as e:
+        logger.warning_once("EXL3 xdense descriptor unavailable: %r" % (e,))
+        return None
+
+
+def _xdense_run(xd, x_fp16):
+    m = _xdense_mod()
+    rows = int(x_fp16.shape[0])
+    if m is None or rows > 16 or int(x_fp16.shape[1]) != xd["in_f"]:
+        return None
+    out = torch.empty((rows, xd["total"]), dtype=x_fp16.dtype, device=x_fp16.device)
+    m.xdense_forward(x_fp16, xd["suh"], xd["temp"], xd["a"], xd["b"], xd["c"], xd["bnf"], xd["rows"][rows], xd["svh"], out,
+                     xd["off"], xd["total"], xd["W"], 6, 1)
+    return out
+
+
+def _fused_dense_build(layer, linears) -> None:
+    layer._exl3_fd = None
+    if _EXL3_FUSED_DENSE_ROWS <= 0 or len(linears) < 2 or any(l is None for l in linears):
+        return
+    if getattr(layer, "_exl3_linear_padded", False) or getattr(layer, "_exl3_linear_bf16_shards", []):
+        return
+    import math
+    try:
+        K = {int(l.K) for l in linears}; mcg = {bool(l.mcg) for l in linears}; mul1 = {bool(l.mul1) for l in linears}
+        ins = {int(l.in_features) for l in linears}
+        if len(K) != 1 or len(mcg) != 1 or len(mul1) != 1 or len(ins) != 1:
+            return
+        K = K.pop(); in_f = ins.pop()
+        widths = [int(l.out_features) for l in linears]
+        width = math.gcd(*widths)
+        if width % 128 or width < 256:
+            return
+        total = sum(widths)
+        tp, sp, srcoff, n0s, strides, srcs = [], [], [], [], [], []
+        col = 0
+        for i, l in enumerate(linears):
+            tr = l.trellis
+            if tr.dim() != 3 or tr.shape[-1] != 16 * K or tr.dtype != torch.int16 or not tr.is_contiguous() or not l.svh.is_contiguous():
+                return
+            for n0 in range(0, widths[i], width):
+                tp.append(tr.data_ptr() + (n0 // 16) * 16 * K * tr.element_size())
+                sp.append(l.svh.data_ptr() + n0 * l.svh.element_size())
+                srcoff.append(col); n0s.append(n0)
+                strides.append(widths[i])            # the kernel steps trellis tiles AND output rows by the source width
+                srcs.append(i)
+            col += widths[i]
+        dev = linears[0].trellis.device
+        n_sl = len(tp)
+        layer._exl3_fd = {
+            "K": K, "mcg": mcg.pop(), "mul1": mul1.pop(), "width": width, "total": total, "in_f": in_f,
+            "n_src": len(linears), "n_sl": n_sl,
+            "ptrs_trellis": torch.tensor(tp, dtype=torch.long, device=dev),
+            "ptrs_svh": torch.tensor(sp, dtype=torch.long, device=dev),
+            "ptrs_suh": torch.tensor([l.suh.data_ptr() for l in linears], dtype=torch.long, device=dev),
+            "size_n": torch.full((n_sl,), width, dtype=torch.int32, device=dev),
+            "n_stride": torch.tensor(strides, dtype=torch.int32, device=dev),
+            "had_src": torch.tensor(srcs, dtype=torch.int32, device=dev),
+            "srcoff": torch.tensor(srcoff, dtype=torch.long, device=dev),   # first column of the slice's source in the output
+            "n0": torch.tensor(n0s, dtype=torch.long, device=dev),
+            "widths": widths, "cols": [sum(widths[:i]) for i in range(len(widths))],
+            "carrier": torch.empty((1, 1, width), dtype=torch.float16, device=dev),
+        }
+        logger.info_once("EXL3 fused dense projections ON (<= %d rows): e.g. %d shards %s -> %d slices of %d"
+                         % (_EXL3_FUSED_DENSE_ROWS, len(linears), widths, n_sl, width))
+    except Exception as e:
+        logger.warning_once("EXL3 fused dense projections unavailable: %r" % (e,))
+        layer._exl3_fd = None
+
+
+def _fused_dense_forward(fd, x_fp16: torch.Tensor) -> torch.Tensor:
+    import exllamav3_ext as ext
+    rows = int(x_fp16.shape[0])
+    x3 = x_fp16.view(1, rows, fd["in_f"])
+    temp = torch.empty((fd["n_src"], rows, fd["in_f"]), dtype=torch.float16, device=x_fp16.device)
+    # one buffer, each source's (rows, width_i) output contiguous at element offset rows * col_i
+    buf = torch.empty((rows * fd["total"],), dtype=torch.float16, device=x_fp16.device)
+    c_ptrs = (fd["srcoff"] * rows + fd["n0"]) * 2 + buf.data_ptr()
+    ext.exl3_mgemm(x3, fd["ptrs_trellis"], fd["carrier"].expand(fd["n_sl"], rows, fd["width"]), fd["ptrs_suh"], temp,
+                   fd["ptrs_svh"], None, None, fd["K"], -1, fd["mcg"], fd["mul1"], -1, -1, 0, 1,
+                   fd["size_n"], c_ptrs, fd["n_stride"], fd["had_src"], fd["n_src"])
+    return torch.cat([buf[rows * c: rows * (c + w)].view(rows, w) for c, w in zip(fd["cols"], fd["widths"])], dim=1)
+
+
+# thor Beam FP8 prefill projections (2026-10-18). EXL3_FP8_PROJ=1: a dense EXL3 linear called with >= EXL3_FP8_MIN_ROWS rows
+# (default auto: 256 with the fused f8rh weight kernel, 512 with the Triton fallback) runs on FP8 tensor cores instead of
+# reconstruct -> fp16 cuBLAS GEMM per shard -> fp32 -> cat -> cast. Per call: every shard is reconstructed straight into ONE
+# fp8 [N_total, K] buffer (all shards concatenated, K-major) by the fused kernel kernels/proj8/f8rh.cu (exllamav3's
+# reconstruct_had_kernel + an fp8 transposed store; EXL3_FP8_RECON=triton or a missing extension -> reconstruct_had_slice
+# to fp16 [K, n] slices + a Triton scale/cast/transpose pass, bit-identical), each output channel scaled by a load-time
+# constant (amax over K of that same reconstruct / 448, RN + satfinite); the activation is quantized per token (vLLM
+# dynamic_per_token_scaled_fp8_quant, straight from bf16) and one CUTLASS sm120 scaled_mm (per-token x per-channel scales)
+# writes the concatenated bf16 output. Nothing persistent but N_total fp32 scales per layer; the transient buffers are
+# smaller than the fp16 path's (no fp32 shard outputs + cat). EXL3_FP8_SKIP=<substr,..> keeps matching layers on fp16
+# (e.g. "o_proj" or "mlp."). Decode (<= EXL3_FUSED_DENSE_ROWS) and calls below the row threshold are untouched.
+_EXL3_FP8_PROJ = os.environ.get("EXL3_FP8_PROJ", "0") == "1"
+_EXL3_FP8_MIN_ROWS = int(os.environ.get("EXL3_FP8_MIN_ROWS", "0") or 0)   # 0 = auto: 256 with the fused f8rh weights, else 512
+_EXL3_FP8_SLICE = int(os.environ.get("EXL3_FP8_SLICE", "4096") or 4096)
+_EXL3_FP8_SKIP = tuple(s for s in os.environ.get("EXL3_FP8_SKIP", "").split(",") if s)
+_EXL3_FP8_GEMM = os.environ.get("EXL3_FP8_GEMM", "cutlass")   # cutlass (vLLM ops.cutlass_scaled_mm) | torch (_scaled_mm rowwise)
+_EXL3_FP8_RECON = os.environ.get("EXL3_FP8_RECON", "fused")   # fused (f8rh ext: reconstruct straight to fp8) | triton
+_EXL3_FP8_EXT_DIR = os.environ.get("EXL3_FP8_EXT_DIR", "/opt/recipe/kernels/build/f8rh")
+_THOR_F8_KERNEL = None
+_FP8_MAX = 448.0
+_FP8_LAYERS = 0
+_F8RH = None
+# EXL3_FP8_DTYPE=int8 (2026-10-18): W8A8 INT8 in a Hadamard-rotated basis instead of FP8 in the original basis (e4m3's 3-bit
+# mantissa = ~2.6 % RMS error per operand; int8 on incoherent data ~0.9 %). Activations: xh = x diag(suh_0) H/sqrt(128) per
+# 128-block (suh_0 = first shard's input scales; one Triton kernel, fp16 x (suh-scaled +-1 H) dots, per-token amax pass +
+# quantize pass); weights per shard i: Hn diag(suh_i/suh_0) Hn W_hat Hn diag(svh_i) (x8rh kernel, had_k 0/2; = W_orig left-
+# rotated so x W_orig = xh W'), int8 per output channel (amax from the same kernel at load); cuBLASLt int8 GEMM (torch._int_mm)
+# + Triton per-token x per-channel scale epilogue (vLLM's cutlass_scaled_mm has no int8 on SM120).
+_EXL3_FP8_DTYPE = os.environ.get("EXL3_FP8_DTYPE", "fp8")
+_EXL3_X8_EXT_DIR = os.environ.get("EXL3_X8_EXT_DIR", "/opt/recipe/kernels/build/x8rh")
+_X8RH = None
+_THOR_HQ_KERNEL = None
+_HQ_H = {}
+
+
+def _x8rh():
+    global _X8RH
+    if _X8RH is None:
+        _X8RH = False
+        try:
+            import importlib
+            import sys as _sys
+            if _EXL3_X8_EXT_DIR not in _sys.path:
+                _sys.path.insert(0, _EXL3_X8_EXT_DIR)
+            _X8RH = importlib.import_module("x8rh")
+        except Exception as e:
+            logger.warning("EXL3 INT8 projections: x8rh extension unavailable (%r)" % (e,))
+    return _X8RH or None
+
+
+def _thor_hq_kernel():
+    global _THOR_HQ_KERNEL
+    if _THOR_HQ_KERNEL is None:
+        import triton
+        import triton.language as tl
+
+        @triton.jit(do_not_specialize=["M"])   # no re-JIT for row counts that are not multiples of 16
+        def _had_quant_i8(x_ptr, suh_ptr, h_ptr, q_ptr, s_ptr, M, K, stride_x, stride_q, BM: tl.constexpr):
+            # per 128-block: xh = (x . suh) @ H / sqrt(128) (H = Sylvester +-1); per-row amax pass, then RN int8 quantize pass
+            pid = tl.program_id(0)
+            rm = pid * BM + tl.arange(0, BM)
+            mm = rm < M
+            rc = tl.arange(0, 128)
+            H = tl.load(h_ptr + rc[:, None] * 128 + rc[None, :])
+            amax = tl.zeros([BM], dtype=tl.float32)
+            for kb in range(0, K, 128):
+                x = tl.load(x_ptr + rm[:, None].to(tl.int64) * stride_x + kb + rc[None, :], mask=mm[:, None], other=0.0).to(tl.float16)
+                su = tl.load(suh_ptr + kb + rc)
+                y = tl.dot(x, H * su[:, None])
+                amax = tl.maximum(amax, tl.max(tl.abs(y), axis=1))
+            amax = amax * 0.08838834764831845
+            scale = tl.maximum(amax, 1e-12) / 127.0
+            inv = 0.08838834764831845 / scale
+            for kb in range(0, K, 128):
+                x = tl.load(x_ptr + rm[:, None].to(tl.int64) * stride_x + kb + rc[None, :], mask=mm[:, None], other=0.0).to(tl.float16)
+                su = tl.load(suh_ptr + kb + rc)
+                y = tl.dot(x, H * su[:, None]) * inv[:, None]
+                y = tl.where(y >= 0, y + 0.5, y - 0.5)
+                y = tl.minimum(tl.maximum(y, -127.0), 127.0)
+                tl.store(q_ptr + rm[:, None].to(tl.int64) * stride_q + kb + rc[None, :], y.to(tl.int32).to(tl.int8), mask=mm[:, None])
+            tl.store(s_ptr + rm, scale, mask=mm)
+
+        _THOR_HQ_KERNEL = _had_quant_i8
+    return _THOR_HQ_KERNEL
+
+
+def _had_quant_i8(x2d: torch.Tensor, suh: torch.Tensor):
+    dev = x2d.device
+    H = _HQ_H.get(dev)
+    if H is None:
+        i = torch.arange(128, device=dev)
+        pc = torch.zeros(128, 128, dtype=torch.int64, device=dev)
+        a = i[:, None] & i[None, :]
+        for b in range(7):
+            pc += (a >> b) & 1
+        H = _HQ_H[dev] = (1 - 2 * (pc & 1)).to(torch.float16).contiguous()
+    M, K = int(x2d.shape[0]), int(x2d.shape[1])
+    q = torch.empty((M, K), dtype=torch.int8, device=dev)
+    s = torch.empty((M, 1), dtype=torch.float32, device=dev)
+    BM = 16   # 16 rows per program: 256 programs at 4096 rows (64 rows/program left 2/3 of the SMs idle: 157 -> ? us)
+    _thor_hq_kernel()[(triton_cdiv(M, BM),)](x2d, suh, H, q, s, M, K, x2d.stride(0), q.stride(0), BM=BM, num_warps=4)
+    return q, s
+
+
+def triton_cdiv(a, b):
+    return (a + b - 1) // b
+
+
+_THOR_I32_KERNEL = None
+_EXL3_I8_NCHUNK = int(os.environ.get("EXL3_I8_NCHUNK", "8192") or 8192)   # columns per int32 accumulator chunk (memory cap)
+
+
+def _thor_i32_kernel():
+    global _THOR_I32_KERNEL
+    if _THOR_I32_KERNEL is None:
+        import triton
+        import triton.language as tl
+
+        @triton.jit(do_not_specialize=["M", "N"])
+        def _i32_scale(a_ptr, sa_ptr, sb_ptr, y_ptr, M, N, stride_a, stride_y, BM: tl.constexpr, BN: tl.constexpr):
+            rm = tl.program_id(0) * BM + tl.arange(0, BM)
+            rn = tl.program_id(1) * BN + tl.arange(0, BN)
+            m = (rm[:, None] < M) & (rn[None, :] < N)
+            acc = tl.load(a_ptr + rm[:, None].to(tl.int64) * stride_a + rn[None, :], mask=m, other=0).to(tl.float32)
+            sa = tl.load(sa_ptr + rm, mask=rm < M, other=0.0)
+            sb = tl.load(sb_ptr + rn, mask=rn < N, other=0.0)
+            tl.store(y_ptr + rm[:, None].to(tl.int64) * stride_y + rn[None, :], (acc * sa[:, None] * sb[None, :]).to(y_ptr.dtype.element_ty), mask=m)
+
+        _THOR_I32_KERNEL = _i32_scale
+    return _THOR_I32_KERNEL
+
+
+def _int8_gemm(xq, xs, w8, scale, out_dtype) -> torch.Tensor:
+    """y = (xq @ w8^T) * xs * scale -> out_dtype. vLLM's cutlass_scaled_mm refuses int8 on SM120, so: cuBLASLt int8 GEMM
+    (torch._int_mm, int32 out, ~520 TOPS here = the fp8 rate) per column chunk + one Triton scale/cast pass per chunk."""
+    M, N = int(xq.shape[0]), int(w8.shape[0])
+    y = torch.empty((M, N), dtype=out_dtype, device=xq.device)
+    xs1 = xs.reshape(-1)
+    for n0 in range(0, N, _EXL3_I8_NCHUNK):
+        n1 = min(N, n0 + _EXL3_I8_NCHUNK)
+        acc = torch._int_mm(xq, w8[n0:n1].t())
+        BM, BN = 64, 128
+        _thor_i32_kernel()[(triton_cdiv(M, BM), triton_cdiv(n1 - n0, BN))](
+            acc, xs1, scale[n0:n1], y[:, n0:n1], M, n1 - n0, acc.stride(0), y.stride(0), BM=BM, BN=BN, num_warps=4)
+    return y
+
+
+def _f8rh():
+    """The fused reconstruct -> fp8 [N, K] extension (kernels/proj8/f8rh.cu), or None (-> Triton convert path)."""
+    global _F8RH
+    if _F8RH is None:
+        _F8RH = False
+        if _EXL3_FP8_RECON == "fused":
+            try:
+                import importlib
+                import sys as _sys
+                if _EXL3_FP8_EXT_DIR not in _sys.path:
+                    _sys.path.insert(0, _EXL3_FP8_EXT_DIR)
+                _F8RH = importlib.import_module("f8rh")
+            except Exception as e:
+                logger.warning("EXL3 FP8: fused reconstruct extension unavailable (%r); using the Triton convert" % (e,))
+    return _F8RH or None
+
+
+def _thor_f8_kernel():
+    global _THOR_F8_KERNEL
+    if _THOR_F8_KERNEL is None:
+        import triton
+        import triton.language as tl
+
+        @triton.jit
+        def _w16_to_f8t(w_ptr, inv_ptr, o_ptr, stride_w, stride_o, BK: tl.constexpr, BN: tl.constexpr):
+            # w: fp16 [K, n] row-major (stride_w), inv: fp32 [n], o: fp8 [n, K] row-major (stride_o). K, n multiples of BK/BN.
+            pn = tl.program_id(0)
+            pk = tl.program_id(1)
+            rk = pk * BK + tl.arange(0, BK)
+            rn = pn * BN + tl.arange(0, BN)
+            w = tl.load(w_ptr + rk[:, None].to(tl.int64) * stride_w + rn[None, :])
+            s = tl.load(inv_ptr + rn)
+            v = w.to(tl.float32) * s[None, :]
+            v = tl.minimum(tl.maximum(v, -448.0), 448.0)
+            q = tl.trans(v.to(tl.float8e4nv))
+            tl.store(o_ptr + rn[:, None].to(tl.int64) * stride_o + rk[None, :], q)
+
+        _THOR_F8_KERNEL = _w16_to_f8t
+    return _THOR_F8_KERNEL
+
+
+def _f8_convert(w16: torch.Tensor, inv: torch.Tensor, out: torch.Tensor) -> None:
+    """w16 fp16 [K, n] (row stride w16.stride(0)) -> out fp8 [n, K] rows (row stride out.stride(0)), column j scaled by inv[j]."""
+    K, n = int(w16.shape[0]), int(w16.shape[1])
+    BK, BN = 64, 64
+    _thor_f8_kernel()[(n // BN, K // BK)](w16, inv, out, w16.stride(0), out.stride(0), BK=BK, BN=BN, num_warps=4)
+
+
+def _fp8_proj_build(layer, linears) -> None:
+    layer._exl3_f8 = None
+    if not _EXL3_FP8_PROJ or not linears or any(l is None for l in linears):
+        return
+    if getattr(layer, "_exl3_linear_padded", False) or getattr(layer, "_exl3_linear_bf16_shards", []):
+        return
+    name = str(getattr(layer, "_exl3_prefix", None) or getattr(layer, "prefix", None) or "")
+    if any(s in name for s in _EXL3_FP8_SKIP):
+        return
+    try:
+        import exllamav3_ext as ext
+        ins = {int(l.in_features) for l in linears}
+        if len(ins) != 1:
+            return
+        K = ins.pop()
+        widths = [int(l.out_features) for l in linears]
+        if K % 128 or any(w % 128 for w in widths):
+            return
+        dev = linears[0].trellis.device
+        if _EXL3_FP8_DTYPE == "int8":
+            _int8_proj_build(layer, linears, K, widths, name, dev)
+            return
+        amax = []
+        for l, n in zip(linears, widths):
+            for n0 in range(0, n, _EXL3_FP8_SLICE):
+                n1 = min(n, n0 + _EXL3_FP8_SLICE)
+                w16 = torch.empty((K, n1 - n0), dtype=torch.float16, device=dev)
+                ext.reconstruct_had_slice(w16, l.trellis, l.suh, l.svh[n0:], l.K, l.mcg, l.mul1, n0)
+                amax.append(w16.abs().amax(dim=0).float())
+                del w16
+        amax = torch.cat(amax)
+        scale = (amax / _FP8_MAX).clamp(min=1e-12)
+        shards, col = [], 0
+        for l, n in zip(linears, widths):
+            shards.append((l, col, n))
+            col += n
+        layer._exl3_f8 = {
+            "K": K, "N": col, "shards": shards,
+            "scale": scale.contiguous(),                         # [N] fp32 (cutlass per-channel / torch rowwise view (1, N))
+            "inv": (1.0 / scale).contiguous(),
+            "max_slice": min(max(widths), _EXL3_FP8_SLICE),
+            "min_rows": _EXL3_FP8_MIN_ROWS or (256 if _f8rh() is not None else 512),
+        }
+        global _FP8_LAYERS
+        _FP8_LAYERS += 1
+        if _FP8_LAYERS == 1:
