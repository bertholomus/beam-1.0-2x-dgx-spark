# beam-tf.env: serving configuration for Beam-1.0-501B-A23B EXL3 on two DGX Spark (GB10) nodes with TensorFold, tensor
# parallel 2 over one 200G RoCE link, DFlash2 always on. Sourced by tf/beam-tf-serve.sh. Every value can be overridden from
# the caller's environment.

# Engine: a clone of the TensorFold fork on the control machine; the script copies one commit of it (git archive, never a
# working copy) to both nodes at each start
REPO=${REPO:-$HOME/TensorFold}                  # git clone -b beam-1.0-tp2 https://github.com/bertholomus/TensorFold
REV=${REV:-d00201b420a81e467c681dc7fe8ca903e24d076b}  # the measured build (branch beam-1.0-tp2)
IMAGE=${IMAGE:-nvcr.io/nvidia/pytorch:26.07-py3}

# Weights: paths on each node, the same paths on both
PACK=${PACK:?set PACK to the Beam EXL3 pack directory}
DRAFT=${DRAFT:?set DRAFT to the reflection/Beam-1.0-501B-A23B-DFlash2 directory}
TF_DIR=${TF_DIR:-beam-tf}                       # under each node's home: the staged tree, logs and build caches
API_KEY_FILE=${API_KEY_FILE:-beam-tf/api_key}   # under the head node's home: made at the first start (mode 600), never printed

# Two nodes: rank 0, the scheduler and the OpenAI API on $HEAD_HOST, rank 1 on $WORKER_HOST, over QSFP port 0 of each Spark
HEAD_HOST=${HEAD_HOST:-spark1}
HEAD_IP=${HEAD_IP:-10.0.0.1}                    # rank 0's link address: the NCCL and Gloo bootstrap
WORKER_HOST=${WORKER_HOST:-spark2}
MASTER_PORT=${MASTER_PORT:-29571}
NET_IF=${NET_IF:-enp1s0f0np0}                   # bootstrap sockets on the 200G port, never the LAN
NCCL_IB_HCA=${NCCL_IB_HCA-}                     # empty: NCCL uses the RoCE functions it finds
NCCL_IB_GID_INDEX=${NCCL_IB_GID_INDEX:-5}       # the RoCE v2 IPv4 GID of the link address on our nodes (show_gids)
NCCL_MAX_NCHANNELS=${NCCL_MAX_NCHANNELS:-4}     # each channel has host buffers (no GPU Direct RDMA on GB10): 4 keep ~3 GiB
                                                # per node free at the same speed and bits
NCCL_DEBUG=${NCCL_DEBUG:-WARN}
HOST=${HOST:-127.0.0.1}                         # the API listens here on the head node
PORT=${PORT:-8000}
SERVED=${SERVED:-beam-1.0}

# Memory: the engine sizes its KV pool from what the 9 GiB floor and its reserves leave (868,352 positions a node in our
# served start, at most CONTEXT); one stream can use the whole pool
CONTEXT=${CONTEXT:-1048576}                     # Beam's longest context, asked
GUARD_MIB=${GUARD_MIB:-9216}                    # tf/memguard.sh stops a rank whose node falls under this MemAvailable
MIN_START_GIB=${MIN_START_GIB:-110}             # free memory each node needs before a start
READY_MIN=${READY_MIN:-30}
GLIBC_TUNABLES=${GLIBC_TUNABLES-glibc.malloc.mmap_threshold=131072:glibc.malloc.trim_threshold=131072:glibc.malloc.arena_max=4}
EXT_DIR=${EXT_DIR:-/root/.cache/torch_extensions_serve}   # the CUDA extension builds, in the containers (~/$TF_DIR/cache)

# The measured settings: 4-bit drafter weights and draft head, 5 drafts a step adapting between 3 and 5, 16 rows a decode
# step, the mma3 prompt expert kernel, 4,096-row prompt chunks with o_proj and the next layer's projections in 1,024-row
# pieces, 4 prompt cache entries, the prompt chunks' rank sums as reduce-scatters
KNOBS=${KNOBS:-TF_BEAM_DRAFT_BITS=4 TF_BEAM_DRAFT_HEAD_BITS=4 TF_BEAM_SPEC_K=5 TF_BEAM_K_ADAPT=3,5 TF_BEAM_DECODE_ROWS=16 TF_EXL3_PROMPT_KERNEL=mma3 TF_BEAM_CHUNK=4096 TF_BEAM_SPLIT=1024 TF_BEAM_PROMPT_CACHE=4 TF_BEAM_RS=1}
