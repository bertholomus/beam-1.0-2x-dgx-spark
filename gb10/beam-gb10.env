# beam-gb10.env: serving configuration for Beam-1.0-501B-A23B EXL3 on two DGX Spark (GB10) nodes, vLLM tensor-parallel 2 over one
# 200G RoCE link. Sourced by gb10/serve-node.sh and gb10/beam-serve.sh. Every value can be overridden from the caller's environment.
# Upstream defaults (diffbot's recipe/serve/serve.sh, 2x RTX PRO 6000) are noted where the GB10 value differs.

# Image, weights, recipe (paths on each node; the same paths on both)
IMAGE=${IMAGE:-beam-exl3-gb10}
NAME=${NAME:-beam-exl3}
PACK=${PACK:?set PACK to the Beam EXL3 pack directory}
DRAFT=${DRAFT:?set DRAFT to the reflection/Beam-1.0-501B-A23B-DFlash2 directory}
RECIPE=${RECIPE:?set RECIPE to the recipe folder from the diffbot repo, with kernels/build from gb10/build-kernels.sh}
CACHE_DIR=${CACHE_DIR:-$HOME/beam-serve/cache}
API_KEY_FILE=${API_KEY_FILE:-$HOME/beam-serve/api_key}

# Two nodes: rank 0 = engine + OpenAI API, rank 1 = headless worker, over QSFP port 0 of each Spark (enp1s0f0np0). Rank 0 also runs
# the API server and the engine core (~1.5 GB of host memory), so give it the node with more free memory; clients on the other node
# reach the API through its 127.0.0.1:$PORT relay (API_FWD_HOST).
HEAD_HOST=${HEAD_HOST:-spark1}
HEAD_IP=${HEAD_IP:-10.0.0.1}
WORKER_HOST=${WORKER_HOST:-spark2}
WORKER_IP=${WORKER_IP:-10.0.0.2}
MASTER_PORT=${MASTER_PORT:-29517}
NET_IF=${NET_IF:-enp1s0f0np0}                       # torch.distributed / Gloo / NCCL bootstrap on the 200G port, never the LAN
NCCL_IB_HCA=${NCCL_IB_HCA:-rocep1s0f0,roceP2p1s0f0} # both RoCE functions of QSFP port 0
NCCL_DEBUG=${NCCL_DEBUG:-WARN}
NCCL_MAX_NCHANNELS=${NCCL_MAX_NCHANNELS:-4}         # NCCL picks 64 channels here, each with host buffers (no GPU Direct RDMA on GB10):
                                                    # ~2.5 GiB of shared memory + 0.7 GiB GPU memory per node. 4 channels free ~3.3 GiB
                                                    # per node at the same speed and the same bits (a 2-rank all-reduce is a+b in every
                                                    # channel layout)
API_HOST=${API_HOST:-10.0.0.1}                      # upstream 0.0.0.0; listens on the head node's 200G-link address only
API_FWD_HOST=${API_FWD_HOST-spark2}                 # node whose 127.0.0.1:$PORT relays to $API_HOST:$PORT (gb10/apifwd.py); empty = no relay
PORT=${PORT:-8000}
SERVED=${SERVED:-beam-1.0}

# Shapes
MAX_MODEL_LEN=${MAX_MODEL_LEN:-655360}              # upstream 131072. 655,360 (640K) is the longest that kept 9 GiB MemAvailable on both
                                                    # nodes with DFlash2 on (measured); Beam allows 1,048,576. On an OS image that keeps
                                                    # less memory free, lower it together with KV_MEM
MAX_NUM_SEQS=${MAX_NUM_SEQS:-8}
MAX_BATCHED=${MAX_BATCHED:-2048}                    # upstream 4096; 2048 keeps ~0.5 GiB more free under load and makes each request's
                                                    # sliding-window KV smaller, for ~14 % slower cold prefill
UTIL=${UTIL:-0.77}                                  # upstream 0.94 of 96 GB VRAM; here only vLLM's startup free-memory check (pool: KV_MEM)
KV_MEM=${KV_MEM-6343262208}                         # KV pool per rank in bytes (vLLM --kv-cache-memory) = 43,018 blocks of 147,456 B (5.91 GiB)
                                                    # with KV groups of 9 (below): one 655,360-token request = 40,960 + 1,958 blocks (289
                                                    # per window-512 group, 513 for the drafter at MAX_BATCHED 2048) + 100 spare. For another
                                                    # MAX_MODEL_LEN L: KV_MEM = (ceil(L / 16) + 2,058) x 147,456 (vLLM refuses to start when
                                                    # one request does not fit). Empty = size it from UTIL by profiling (on unified memory
                                                    # each rank profiles differently)
KV_DTYPE=${KV_DTYPE:-fp8}
KV_OFFLOAD=${KV_OFFLOAD:-0}                         # upstream 64 GiB CPU KV tier; on unified memory it would take the same RAM the GPU pool uses
SPEC=${SPEC:-dflash}                                # DFlash2 drafter, as upstream; none = off
SPEC_K=${SPEC_K:-3}
SPEC_ATTN=${SPEC_ATTN:-FLASHINFER}
CAPTURE_SIZES=${CAPTURE_SIZES:-"1 2 4 8 16 24 32 40 48 56 64"}
EAGER=${EAGER:-0}                                   # 0 = CUDA graphs FULL_DECODE_ONLY (upstream); 1 = eager
NO_CUSTOM_AR=${NO_CUSTOM_AR:-1}                     # upstream empty (one-shot P2P all-reduce); two hosts have no P2P: NCCL all-reduce

# Recipe kernels and hooks (same names as upstream serve.sh)
HOSTPLAN=${HOSTPLAN-}                               # upstream host31-robust.json; unified memory: host-RAM experts save nothing, all experts in device memory
XMOE_EXT=${XMOE_EXT-xmoe_dense}
THOR_EMBED_HOST=${THOR_EMBED_HOST:-0}               # upstream 1; the embedding table in pinned host RAM saves nothing on unified memory

# KV cache layout (gb10/beam_gb10_hooks.py): groups of 9 layers instead of vLLM's 5 (set by the drafter's 5 layers), so the 9
# full-attention layers fill one group with no padding layer: 9,216 instead of 10,240 B of KV per token per rank. Empty = vLLM's.
export BEAM_GB10_KV_GROUP_SIZE=${BEAM_GB10_KV_GROUP_SIZE-9}

# FlashInfer workspace: vLLM gives each FlashInfer metadata builder its own 394 MiB buffer. 128 MiB is above vLLM's own prefill
# estimate at MAX_BATCHED 2048 (2048 tokens x 24 heads x 128 x 16 B = 96 MiB) and frees ~0.6 GiB per node. vLLM default 413138944.
export VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE=${VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE:-134217728}

# Host heap: fixed glibc mmap/trim thresholds hand freed load buffers back to the OS (~0.3 GiB per node); empty = glibc default
GLIBC_TUNABLES=${GLIBC_TUNABLES-glibc.malloc.mmap_threshold=131072:glibc.malloc.trim_threshold=131072:glibc.malloc.arena_max=4}
